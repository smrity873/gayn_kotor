# =============================================================================
# Gayn Kotor — Environment Configuration Template
# =============================================================================

# Django Security
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
SITE_NAME=Gayn Kotor

# PostgreSQL Database (Neon or Local)
DB_NAME=gayn_kotor
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Feature Toggles
ENABLE_VIDEO_COURSES=True
SANDBOX_ALLOWED=True

# Payment Configuration
PAYMENT_GATEWAY=sandbox
CREDIT_PRICE_BDT=1.00
CREDIT_TOPUP_MIN=10
CREDIT_TOPUP_MAX=5000
WITHDRAW_MIN_BDT=500.00

# Private Storage Location
PRIVATE_MEDIA_ROOT=private_media

# Review Queue Escalation Timers (in days)
NOTE_CR_REMINDER_DAYS=2
NOTE_ESCALATE_DAYS=3
NOTE_AUTOPUBLISH_DAYS=7
NOTE_FLAG_THRESHOLD=3
