# Django Security
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
SITE_NAME=Gayn Kotor

# PostgreSQL Database (Neon Postgres Serverless)
DATABASE_URL="postgresql://neondb_owner:password@ep-patient-brook-aofsyj1k-pooler.c-2.ap-southeast-1.aws.neon.tech/gyan-kotor-db?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-patient-brook-aofsyj1k.c-2.ap-southeast-1.aws.neon.tech/gyan-kotor-db?channel_binding=require&sslmode=require"

# AWS / Neon S3 Object Storage (Files & Media)
AWS_ACCESS_KEY_ID=nak_live_your_key_here
AWS_SECRET_ACCESS_KEY=nsk_live_your_secret_here
AWS_STORAGE_BUCKET_NAME=uploads
AWS_ENDPOINT_URL_S3=https://br-empty-wave-ao3fubx3.storage.c-2.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1

# Email Service Configuration (Verification & Notifications)
# In development (DEBUG=True), defaults to console. Set EMAIL_BACKEND to smtp for live delivery:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Gayn Kotor <noreply@gaynkotor.com>

# bKash Payment Gateway (Tokenized Sandbox / Production)
# Docs: https://developer.bka.sh/docs
PAYMENT_GATEWAY=bkash
SANDBOX_ALLOWED=True
BKASH_SANDBOX_MODE=True
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Test credentials:
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Feature Toggles
ENABLE_VIDEO_COURSES=True
CREDIT_PRICE_BDT=1.00
CREDIT_TOPUP_MIN=10
CREDIT_TOPUP_MAX=5000
WITHDRAW_MIN_BDT=500.00

# Private Storage Location (local fallback)
PRIVATE_MEDIA_ROOT=private_media

# Review Queue Escalation Timers (in days)
NOTE_CR_REMINDER_DAYS=2
NOTE_ESCALATE_DAYS=3
NOTE_AUTOPUBLISH_DAYS=7
NOTE_FLAG_THRESHOLD=3
